#!/usr/bin/expect -f

set timeout 30

set telnet_server $env(TELNET_SERVER)
set telnet_port $env(TELNET_PORT)

set hostname $env(NAME)

set host_network $env(HOST_NETWORK)

proc log_message {message} {
    puts stdout "$message"
}

proc close_and_wait {spawn_id} {
    close -i $spawn_id
    wait -i $spawn_id
}  

proc error {spawn_id close message} {
    log_message $message
    if {$close eq "true"} {
        close_and_wait $spawn_id
    }
    exit 1
}

log_message "\n***** Configure hostname on colibri *****"
spawn telnet $telnet_server $telnet_port
expect {
    "Connected to $telnet_server" {
        send "\n\r"
        expect -re {.*#\s*}
    }
    "Connection closed by foreign host." {
        error $spawn_id "false" \ 
            "$telnet_server:$telnet_port refused the connection"
    }
    timeout {
        error $spawn_id "true" \ 
            "Error: Timed out trying to connect to $telnet_server:$telnet_port.
            Closing Telnet Connection"
    }
    eof {
        error $spawn_id "false" \ 
            "Error: Failed to connect to $telnet_server:$telnet_port."
    }
}

send "configure-network -w -r $host_network $hostname && echo SUCCESS || echo FAILURE\r"
expect {
    "SUCCESS" {
        expect -re {.*#\s*}
        log_message "Hostname configured to: $hostname
            Closing Telnet Connection"
    }
    "FAILURE" {
        error $spawn_id "true" \
            "Error: Failed to configure hostname $expect_out(buffer)
            Closing Telnet Connection"
    }
    timeout {
        error $spawn_id "true" \
            "Error: Failed to configure hostname $expect_out(buffer)
            Closing Telnet Connection"
    }
}

# Delete any old ssh keys
send "rm -f /root/.ssh/authorized_keys"
close_and_wait $spawn_id

log_message "\n***** Transfer SSH Authorisation key to colibri"
# Need to transfer the FPGA binary
set ssh_key $env(SSH_KEY)
spawn ssh-copy-id -i $ssh_key root@$hostname
expect {
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    "password" {
        send "root\r"
        exp_continue
    }
    "Number of key(s) added: 1" {
        log_message "SSH authorization key transferred to colibri"
    }
}
