#!/usr/bin/expect -f

set timeout 30

set d2dcc_dir $env(D2DCC_DIR)

set telnet_server $env(TELNET_SERVER)
set telnet_port $env(TELNET_PORT)

# Will be changed to just use NAME
set hostname $env(SERVER_HOSTNAME)

set power_supplies_dir $env(POWER_SUPPLIES_DIR)
set fpga_type $env(FPGA_TYPE)
set fpga_type_number $env(FPGA_TYPE_NUMBER)
set server_port $env(SERVER_PORT)
set proc_port $env(SERVER_PROC_PORT)

set installer_dir "/tmp"

set host_network "dev"

proc log_message {message} {
    puts stdout "\n$message"
}

log_message "\n***** Configure hostname on colibri *****"
spawn telnet $telnet_server $telnet_port
expect {
    "Connected to $telnet_server" {
        send "\n\r"
        expect -re {.*#\s*}
    }
    "Connection closed by foreign host." {
        log_message "Error: $telnet_server:$telnet_port refused the connection"
        log_message "Closing Telnet Connection"
        close
        wait
        exit 1
    }
    timeout {
        log_message "Error: Timed out trying to connect to $telnet_server:$telnet_port."
        log_message "Closing Telnet Connection"
        close
        wait
        exit 1
    }
    eof {
        log_message "Error: Failed to connect to $telnet_server:$telnet_port."
        log_message "Closing Telnet Connection"
        close
        wait
        exit 1
    }
}
send "configure-network -w -r $host_network $hostname && echo SUCCESS || echo FAILURE\r"
expect {
    "SUCCESS" {
        expect -re {.*#\s*}
        log_message "Hostname configured to: $hostname"
        log_message "Closing Telnet Connection"
        close 
        wait
    }
    "FAILURE" {
        log_message "ERROR: Failed to configure hostname $expect_out(buffer)"
        log_message "Closing Telnet Connection"
        close
        wait
        exit 1
    }{
    }
    timeout {
        log_message "ERROR: Timed out configuring the network."
        log_message "Closing Telnet Connection"
        close
        wait
        exit 1
    }
    eof {
        log_message "ERROR: Failed to configure the network."
        log_message "Closing Telnet Connection"
        close
        wait
        exit 1
    }
}

log_message "\n***** Transfer install script to Colibri via SCP"
spawn scp \
    "-O" \
    "$d2dcc_dir/bin/linux-arm_elhf/installer_server.sh" \
    "root@$hostname:$installer_dir"

# SHA Fingerprint Promt
expect "yes/no" {
    send "yes\r"
}

expect "password" {
    send "root\r"
    expect eof
    log_message "Files transfered to colibri"
}


log_message "\n***** Set up environment and install the server *****"

# Install the server but dont start the server as the FPGA binaries are not sent yet
spawn ssh root@$hostname "cd $installer_dir; ./installer_server.sh -n && echo SUCCESS || echo FAILURE"
expect { 
    "password" {
        send "root\r"
        exp_continue
    }
    "SUCCESS" {
        log_message "Server has been installed."
    }
    "FAILURE" {
        log_message "Error: Failed installing server.\r $expect_out(buffer)"
        exit 1
    }
    timeout {
        log_message "Error: Timed out installing the server"
        exit 1
    }
}

# Need to get the FPGA versions from the colibri to copy the correct binary
spawn ssh root@$hostname "/opt/bin/create_version_file && echo SUCCESS || echo FAILURE" 
expect {
    "password" {
        send "root/r"
        set data {}
        foreach line [split $output "\n"] {
            if {[regexp {^(\S+)\s+(.*)$} $line -> key value]} {
                dict set data $key $value
            }
        }
        exp_continue
    }
    "SUCCESS" {
        set output $expect_out(buffer)
        log_message "Version file created"
    }
    "FAILURE" {
        log_message "ERROR: Failed to create version file $expect_out(buffer)"
        exit 1
    }
}


# Transfer the FPGA Binary
set fpga_bin_paths []
set fpga_bin {}

### This needs to be changed!!!!!!!!!!!
foreach fpga [split $fpga_type "_"]  {
    if {$fpga==SIC} {
        set sic_id [dict get $data SI]
        set sic_mode [dict get $data SM]
        set sic_bin "sic_${sic_id}_v{sic_mode}.bin" 
        set file_path "${power_supplies_dir}/SIC/firmware/$sic_bin" 
        if {[file exists $file_path]} {
            lappend fpga_bin_paths $file_path
            dict set fpga_bin $installer_dir/$sic_bin /opt/bin/sic.bin 
        } else {
            log_message "ERROR: file $file_path does not exist"
            exit 1
        }
    } elseif {$fpga==DPS} {
        set dps_id [dict get $data DI]
        set dps_mode [dict get $data DM]
        set dps_bin "dps_${dps_id}_v{dps_mode}.bin" 
        set file_path "${power_supplies_dir}/DPS/firmware/$dps_bin"
        if {[file exists $file_path]} {
            lappend fpga_bin_paths $file_path
            dict set fpga_bin $installer_dir/$dps_bin /opt/bin/dps.bin 
        } else {
            log_message "ERROR: file $file_path does not exist"
            exit 1
        }
    } elseif {$fpga in [list FOFB SOFB]} {
        log_message "ERROR: FRC binaries are not present yet"
        exit 1
    }
}

spawn scp \
    "-O" \
    {*}$fpga_bin_paths \
    "root@$hostname:\tmp"

expect "password" {
    send "root\r"
    expect eof
    log_message "Files transfered to colibri"
}

log_message "\n Set environment and start the server"
foreach {src dest} $fpga_bin {
    spawn ssh root@$hostname "mv $src $dest"
    expect "password" {
        send "root\r"
        expect eof
        log_message "File $src moved to $dest"
    }
}

spawn telnet $telnet_server $telnet_port
expect {
    "Connected to $telnet_server" {
        send "\n\r"
        expect -re {.*#\s*}
    }
    "Connection closed by foreign host." {
        log_message "Error: $telnet_server:$telnet_port refused the connection"
        log_message "Closing Telnet Connection"
        close
        wait
        exit 1
    }
    timeout {
        log_message "Error: Timed out trying to connect to $telnet_server:$telnet_port."
        log_message "Closing Telnet Connection"
        close
        wait
        exit 1
    }
    eof {
        log_message "Error: Failed to connect to $telnet_server:$telnet_port."
        log_message "Closing Telnet Connection"
        close
        wait
        exit 1
    }
}
send "export EXPECTED_FPGA_TYPE=$fpga_type; export EXPECTED_FPGA_TYPE_NUMBER=$fpga_type_number\n"
send "/opt/etc/init.d/begin_server start && echo SUCCESS || echo FAILURE"
expect {
    "SUCCESS" {
        log_message "Server started"
        set exit_code 0
    }
    "FAILURE" {
        log_message "ERROR: Failed to start server $expect_out(buffer)"
        set exit_code 1
    }
}
log_message "Closing Telnet Connection"
close
wait
exit $exit_code
